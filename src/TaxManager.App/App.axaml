<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TaxManager.App.Support"
             x:Class="TaxManager.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <conv:EnumLabelConverter x:Key="EnumLabel" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- ════════════════════════════════════════════════════════════ -->
    <!--  DESIGN SYSTEM — palette dark GitHub-inspired                 -->
    <!--  Page #0d1117 · Surface #161b22 · Border #30363d             -->
    <!--  Accent #58a6ff · Primary #1f6feb · Success #3fb950          -->
    <!-- ════════════════════════════════════════════════════════════ -->

    <!-- Card -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#161b22" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#e6edf3" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#58a6ff" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#c9d1d9" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8b949e" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#c9d1d9" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#0d1117" />
      <Setter Property="Foreground" Value="#c9d1d9" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CaretBrush" Value="#58a6ff" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#1f6feb" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#0d1117" />
      <Setter Property="Foreground" Value="#c9d1d9" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="#c9d1d9" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="#0d1117" />
      <Setter Property="Foreground" Value="#c9d1d9" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#c9d1d9" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1f6feb" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#388bfd" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1158c7" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#1c2128" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#21262d" />
      <Setter Property="Foreground" Value="#c9d1d9" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#30363d" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#161b22" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Tabs -->
    <Style Selector="TabControl">
      <Setter Property="Background" Value="#0d1117" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8b949e" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#e6edf3" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#1c2128" />
    </Style>

    <!-- Lists / grids -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#0d1117" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#c9d1d9" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#21262d" />
      <Setter Property="RowBackground" Value="Transparent" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#161b22" />
      <Setter Property="Foreground" Value="#8b949e" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Foreground" Value="#c9d1d9" />
    </Style>

    <!-- Chrome (header / status bar), KPI tiles, alt panel, warning callout -->
    <Style Selector="Border.chrome">
      <Setter Property="Background" Value="#161b22" />
      <Setter Property="BorderBrush" Value="#30363d" />
    </Style>
    <Style Selector="Border.statCard">
      <Setter Property="Background" Value="#161b22" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.altPanel">
      <Setter Property="Background" Value="#1c2128" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.warning">
      <Setter Property="Background" Value="#3a2d10" />
      <Setter Property="BorderBrush" Value="#9e6a03" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.warningText">
      <Setter Property="Foreground" Value="#e3b341" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Typography extras -->
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#e6edf3" />
    </Style>
    <Style Selector="TextBlock.accent">
      <Setter Property="Foreground" Value="#58a6ff" />
    </Style>

    <!-- Evita che lo stile base di TextBox "trabocchi" nel TextBox interno del NumericUpDown -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- AutoCompleteBox (ricerca comune) -->
    <Style Selector="AutoCompleteBox">
      <Setter Property="Background" Value="#0d1117" />
      <Setter Property="Foreground" Value="#c9d1d9" />
      <Setter Property="BorderBrush" Value="#30363d" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="AutoCompleteBox /template/ TextBox#PART_TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="AutoCompleteBox:focus-within">
      <Setter Property="BorderBrush" Value="#1f6feb" />
    </Style>
  </Application.Styles>

</Application>
