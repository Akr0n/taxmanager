<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TaxManager.Domain\TaxManager.Domain.csproj" />
    <ProjectReference Include="..\..\src\TaxManager.Application\TaxManager.Application.csproj" />
    <ProjectReference Include="..\..\src\TaxManager.Infrastructure\TaxManager.Infrastructure.csproj" />
  </ItemGroup>

  <!-- I ruleset JSON reali vengono copiati nell'output dei test per verificarne il caricamento. -->
  <ItemGroup>
    <Content Include="..\..\data\rulesets\*.json">
      <Link>rulesets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\addizionali\*.json">
      <Link>addizionali\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
